From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UnlimitedBytes <admin@unlimitedbytes.ovh>
Date: Fri, 2 Jan 2026 01:55:35 +0100
Subject: [PATCH] Add thread-safe command execution for cross-region entities

- Confetti.java: Add ensureSync(Entity, Consumer<Entity>) method for entity operations
- KillCommand: Use ensureSync to kill entities on their owning thread
- GiveCommand: Use ensureSync to modify player inventories on their owning thread
- EffectCommands: Use ensureSync for give/clear effect operations on entity's thread

These changes ensure that commands which operate on entities in different regions
are properly scheduled on the correct thread to prevent race conditions.

diff --git a/src/main/java/com/vulpeslab/confetti/Confetti.java b/src/main/java/com/vulpeslab/confetti/Confetti.java
index 3c7ee277ee939f05f7bc669389b77595e689f78f..4eabbdba0ba3422c22962bf45290b0ed19d38c6a 100644
--- a/src/main/java/com/vulpeslab/confetti/Confetti.java
+++ b/src/main/java/com/vulpeslab/confetti/Confetti.java
@@ -9,6 +9,8 @@ import net.minecraft.world.level.ChunkPos;
 import org.bukkit.Location;
 import org.bukkit.craftbukkit.CraftWorld;
 
+import java.util.function.Consumer;
+
 public class Confetti {
 
     public static void runSync(Location location, Runnable runnable) {
@@ -43,6 +45,18 @@ public class Confetti {
         }
     }
 
+    /**
+     * Ensure the consumer runs on the entity's owning region thread.
+     * If already on the correct thread, runs immediately. Otherwise schedules for next tick.
+     */
+    public static void ensureSync(Entity entity, Consumer<Entity> consumer) {
+        if (!isSync((ServerLevel) entity.level(), entity.chunkPosition())) {
+            entity.getBukkitEntity().taskScheduler.schedule(consumer, null, 1);
+        } else {
+            consumer.accept(entity);
+        }
+    }
+
     public static void ensureSync(ServerLevel serverLevel, BlockPos blockPos, Runnable runnable) {
         ensureSync(serverLevel, new ChunkPos(blockPos), runnable);
     }
