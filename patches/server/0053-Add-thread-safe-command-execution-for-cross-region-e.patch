+            list.add(EntitySelector::isEntityValid); // Confetti - thread-safety: add entity validity check
             if (flag) {
                 list.add((entity) -> {
                     return entity.getType().isEnabled(enabledFeatures);
@@ -289,7 +296,18 @@ public class EntitySelector {
         return Util.allOf((List) object);
     }
 
+    // Confetti start - thread-safety: check entity validity during selector iteration
+    private static boolean isEntityValid(Entity entity) {
+        // Entity may have been removed by another thread during iteration
+        // Check both isRemoved() and that the entity still has a valid level
+        return !entity.isRemoved() && entity.level() != null;
+    }
+    // Confetti end
+
     private <T extends Entity> List<T> sortAndLimit(Vec3 pos, List<T> entities) {
+        // Confetti start - thread-safety: filter out entities that may have been removed during collection
+        entities.removeIf(entity -> !isEntityValid(entity));
+        // Confetti end
         if (entities.size() > 1) {
             this.order.accept(pos, entities);
         }
