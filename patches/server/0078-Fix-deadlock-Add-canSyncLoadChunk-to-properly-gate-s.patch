From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UnlimitedBytes <admin@unlimitedbytes.ovh>
Date: Sat, 3 Jan 2026 14:32:13 +0100
Subject: [PATCH] Fix deadlock: Add canSyncLoadChunk to properly gate sync
 chunk loads

The Server thread should never do sync chunk loads as it doesn't hold any region locks.
Previously, isTickThreadFor() was used to decide whether to use sync or async chunk
loading, but the Server thread was incorrectly treated as 'on tick thread' due to
fallback logic that returned true for any TickThread.

This fix:
1. Changes isTickThreadFor() to explicitly return true for the Server thread
   (so validation/ensureTickThread checks pass for packet handling)
2. Adds canSyncLoadChunk() method that returns FALSE for the Server thread
   (so sync chunk loading is prevented)
3. Updates Entity.move and ServerLevel.doBlockEvent to use canSyncLoadChunk()
   for the chunk loading decision

diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index 11b7f15755dde766140c29bedca456c80d53293f..3f5f34f488132a6fa4fe85653419a6a6d1cafd57 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -6,6 +6,7 @@ import net.minecraft.world.level.ChunkPos;
 import net.minecraft.world.level.Level;
 import net.minecraft.world.phys.AABB;
 import net.minecraft.world.phys.Vec3;
+import net.minecraft.util.Mth; // Confetti
 import org.slf4j.Logger;
 import org.slf4j.LoggerFactory;
 
@@ -98,42 +99,80 @@ public class TickThread extends Thread {
     }
 
     public static boolean isTickThreadFor(final Level world, final BlockPos pos) {
-        return isTickThread();
+        return isTickThreadFor(world, pos.getX() >> 4, pos.getZ() >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final ChunkPos pos) {
-        return isTickThread();
+        return isTickThreadFor(world, pos.x, pos.z);
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 pos) {
-        return isTickThread();
+        return isTickThreadFor(world, net.minecraft.util.Mth.floor(pos.x) >> 4, net.minecraft.util.Mth.floor(pos.z) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ) {
+        // Confetti start - check region lock
+        if (world instanceof net.minecraft.server.level.ServerLevel serverLevel) {
+            // For ConfettiTickThreads, check if they hold the region lock
+            if (com.vulpeslab.confetti.threading.ConfettiTickThread.isConfettiTickThread()) {
+                return com.vulpeslab.confetti.Confetti.isSync(serverLevel, new net.minecraft.world.level.ChunkPos(chunkX, chunkZ));
+            }
+            // The Server thread is allowed to process any entity/chunk (for packet handling, etc.)
+            // but should use canSyncLoadChunk() to check if sync chunk loading is safe
+            net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+            if (server != null && Thread.currentThread() == server.getRunningThread()) {
+                return true; // Server thread is allowed to work with any chunk
+            }
+            // For any other thread in a ServerLevel, check if they hold the lock
+            return com.vulpeslab.confetti.Confetti.isSync(serverLevel, new net.minecraft.world.level.ChunkPos(chunkX, chunkZ));
+        }
+        // Confetti end
         return isTickThread();
     }
 
+    // Confetti start - separate method to check if sync chunk loading is safe
+    /**
+     * Checks if the current thread can safely perform synchronous chunk loading for the given chunk.
+     * This is more restrictive than isTickThreadFor() - the Server thread is NOT allowed to do sync
+     * chunk loads even though it passes isTickThreadFor() checks.
+     */
+    public static boolean canSyncLoadChunk(final Level world, final int chunkX, final int chunkZ) {
+        if (!(world instanceof net.minecraft.server.level.ServerLevel serverLevel)) {
+            return isTickThread();
+        }
+        // Only threads that actually hold the region lock can do sync chunk loads
+        // This prevents the Server thread (and any other thread) from deadlocking
+        return com.vulpeslab.confetti.Confetti.isSync(serverLevel, new net.minecraft.world.level.ChunkPos(chunkX, chunkZ));
+    }
+    // Confetti end
+
     public static boolean isTickThreadFor(final Level world, final AABB aabb) {
-        return isTickThread();
+        return isTickThreadFor(world, net.minecraft.util.Mth.floor(aabb.minX) >> 4, net.minecraft.util.Mth.floor(aabb.minZ) >> 4, net.minecraft.util.Mth.floor(aabb.maxX) >> 4, net.minecraft.util.Mth.floor(aabb.maxZ) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final double blockX, final double blockZ) {
-        return isTickThread();
+        return isTickThreadFor(world, net.minecraft.util.Mth.floor(blockX) >> 4, net.minecraft.util.Mth.floor(blockZ) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 position, final Vec3 deltaMovement, final int buffer) {
-        return isTickThread();
+        // Just check the current position, it's usually enough
+        return isTickThreadFor(world, position);
     }
 
     public static boolean isTickThreadFor(final Level world, final int fromChunkX, final int fromChunkZ, final int toChunkX, final int toChunkZ) {
-        return isTickThread();
+        return isTickThreadFor(world, fromChunkX, fromChunkZ) && isTickThreadFor(world, toChunkX, toChunkZ);
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ, final int radius) {
-        return isTickThread();
+        for (int x = chunkX - radius; x <= chunkX + radius; x++) {
+            for (int z = chunkZ - radius; z <= chunkZ + radius; z++) {
+                if (!isTickThreadFor(world, x, z)) return false;
+            }
+        }
+        return true;
     }
 
     public static boolean isTickThreadFor(final Entity entity) {
-        return isTickThread();
+        return isTickThreadFor(entity.level(), entity.chunkPosition());
     }
 }
