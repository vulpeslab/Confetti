--- /dev/null
+++ b/src/main/java/com/vulpeslab/confetti/threading/ConfettiPlayerTicker.java
@@ -0,0 +1,20 @@
+package com.vulpeslab.confetti.threading;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.player.RegionizedPlayerChunkLoader;
+import net.minecraft.server.level.ServerPlayer;
+
+public class ConfettiPlayerTicker {
+
+    public static void tickPlayer(ServerPlayer serverPlayer) {
+        // Tick player connection to process packets
+        serverPlayer.connection.connection.tick();
+
+        // Update player chunk loader
+        final RegionizedPlayerChunkLoader.PlayerChunkLoaderData loader = serverPlayer.moonrise$getChunkLoader();
+        if (loader != null) {
+            loader.update(); // Updates view distances and chunk queues
+            loader.updateQueues(System.nanoTime()); // Processes load/gen/send queues
+        }
+    }
+
+}
