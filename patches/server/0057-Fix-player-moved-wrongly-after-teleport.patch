From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UnlimitedBytes <admin@unlimitedbytes.ovh>
Date: Fri, 2 Jan 2026 16:41:46 +0100
Subject: [PATCH] Fix player moved wrongly after teleport


diff --git a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 4963a564c82c96d7bd196ac336fbefe51dd70723..1201d6e64e481007b6b8a3e01dcac5b39a3bdad3 100644
--- a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -1846,6 +1846,19 @@ public class ServerGamePacketListenerImpl extends ServerCommonPacketListenerImpl
         this.lastPitch = f1;
         // CraftBukkit end
 
+        // Confetti start - Update position tracking variables immediately on teleport
+        // This prevents "moved wrongly" and "moved too quickly" warnings in multi-threaded
+        // environments where a movement packet might be processed concurrently with teleportation.
+        // Without this fix, the validation could compare the new player position against
+        // stale lastGoodX/Y/Z values, triggering false positive warnings.
+        this.firstGoodX = d0;
+        this.firstGoodY = d1;
+        this.firstGoodZ = d2;
+        this.lastGoodX = d0;
+        this.lastGoodY = d1;
+        this.lastGoodZ = d2;
+        // Confetti end
+
         this.awaitingTeleportTime = this.tickCount;
         this.player.moveTo(d0, d1, d2, f, f1); // Paper - Fix Entity Teleportation and cancel velocity if teleported
         this.player.connection.send(new ClientboundPlayerPositionPacket(d0 - d3, d1 - d4, d2 - d5, f - f2, f1 - f3, set, this.awaitingTeleport));
