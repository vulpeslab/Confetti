From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UnlimitedBytes <admin@unlimitedbytes.ovh>
Date: Sat, 3 Jan 2026 16:08:42 +0100
Subject: [PATCH] Fix block entity tick filtering and POI access for
 cross-dimension operations

- Add region filtering to tickBlockEntities() to only tick block entities in locked region
- Add ensurePoiAccessAllowed() helper that allows ConfettiTickThreads to access POI data
  for cross-dimension operations (e.g., nether portal lookups)

diff --git a/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiManager.java b/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiManager.java
index 34389b3d78c7c963d05eb507ee9f6302c61467ca..3f5d47bd4289ff3a76625c7f914e9a3738192884 100644
--- a/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiManager.java
+++ b/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiManager.java
@@ -65,13 +65,26 @@ public class PoiManager extends SectionStorage<PoiSection> implements ca.spotted
         }
     }
 
+    // Confetti start - allow POI access for cross-dimension operations (e.g., nether portal lookups)
+    // ConfettiTickThreads only have locks in their source dimension, but need to access POI
+    // in the destination dimension when handling portal teleportation
+    private void ensurePoiAccessAllowed(final int chunkX, final int chunkZ, final String reason) {
+        // Skip check for ConfettiTickThreads - they may be doing cross-dimension portal lookups
+        // which is safe because POI loading is thread-safe and we're just reading/creating portal data
+        if (com.vulpeslab.confetti.threading.ConfettiTickThread.isConfettiTickThread()) {
+            return;
+        }
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this.world, chunkX, chunkZ, reason);
+    }
+    // Confetti end
+
     @Override
     public Optional<PoiSection> get(final long pos) {
         final int chunkX = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionX(pos);
         final int chunkY = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionY(pos);
         final int chunkZ = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionZ(pos);
 
-        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this.world, chunkX, chunkZ, "Accessing poi chunk off-main");
+        this.ensurePoiAccessAllowed(chunkX, chunkZ, "Accessing poi chunk off-main"); // Confetti
 
