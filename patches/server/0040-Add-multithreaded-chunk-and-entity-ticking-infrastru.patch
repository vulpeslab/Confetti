@@ -0,0 +1,107 @@
+package com.vulpeslab.confetti.threading;
+
+import com.mojang.logging.LogUtils;
+import com.vulpeslab.confetti.region.LevelChunkRegion;
+import com.vulpeslab.confetti.region.LevelChunkRegionMap;
+import com.vulpeslab.confetti.region.RegionPos;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerChunkCache;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.GameRules;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.NaturalSpawner;
+import net.minecraft.world.level.chunk.LevelChunk;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+
+public class ConfettiChunkTicker {
+
+    private static final ThreadLocal<LevelChunkRegion> currentlyTickingRegion = new ThreadLocal<>();
+
+    private final ServerChunkCache serverChunkCache;
+
+    public ConfettiChunkTicker(ServerChunkCache serverChunkCache) {
+        this.serverChunkCache = serverChunkCache;
+    }
+
+    public CompletableFuture<Void> tickChunks(ServerLevel level, NaturalSpawner.SpawnState spawnState) {
+        LevelChunkRegionMap tickingRegions = level.tickingRegions;
+        List<CompletableFuture<Void>> futures = new ArrayList<>();
+
+        tickingRegions.forEach(
+                region -> futures.add(this.tickRegion(level, region, spawnState))
+        );
+
+        return CompletableFuture.allOf(futures.toArray(CompletableFuture[]::new));
+    }
+
+    private CompletableFuture<Void> tickRegion(ServerLevel level, LevelChunkRegion region, NaturalSpawner.SpawnState spawnState) {
+        return level.chunkScheduler.schedule(region.getRegionPos(), () -> this._tickRegion(level, region, spawnState)).exceptionally(e -> {
+            LogUtils.getClassLogger().error("Exception ticking region {}", region.getRegionPos(), e);
+            ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)level.getServer()).moonrise$setChunkSystemCrash(
+                new RuntimeException("Ticking thread crash while ticking region " + region.getRegionPos(), e));
+            return null;
+        });
+    }
+
+    public static boolean isCurrentlyTickingRegion(Level level, RegionPos regionPos) {
+        LevelChunkRegion region = currentlyTickingRegion.get();
+        return region != null && level.equals(region.getLevel()) && regionPos.equals(region.getRegionPos());
+    }
+
+    public static LevelChunkRegion getCurrentlyTickingRegion() {
+        return currentlyTickingRegion.get();
+    }
+
+    private void _tickRegion(ServerLevel level, LevelChunkRegion region, NaturalSpawner.SpawnState spawnState) {
+        try {
+            currentlyTickingRegion.set(region);
+
+            // Tick scheduled tasks for this region
+            region.tickTasks();
+
+            // Tick chunks in this region
+            if (level.tickRateManager().runsNormally()) {
+                region.forEach(chunk -> this._tickChunk(level, chunk, spawnState));
+            }
+
+            // Tick entities in this region
+            region.forEachTickingEntity(ConfettiEntityTicker::tickEntity);
+
+            // Remove empty regions
+            if (region.isEmpty()) {
+                level.tickingRegions.remove(region.getRegionPos());
+            }
+        } finally {
+            currentlyTickingRegion.remove();
+        }
+    }
+
+    private void _tickChunk(ServerLevel level, LevelChunk chunk1, NaturalSpawner.SpawnState spawnState) {
+        // Start - Import the same variables as the original chunk ticking method to make copying new changes easier
+        long j = 1; // Inhabited time increment in ticks
+        boolean flag = level.getGameRules().getBoolean(GameRules.RULE_DOMOBSPAWNING) && !level.players().isEmpty(); // Should run mob spawning code
+        ChunkPos chunkcoordintpair = chunk1.getPos();
+        boolean flag1 = level.ticksPerSpawnCategory.getLong(org.bukkit.entity.SpawnCategory.ANIMAL) != 0L && level.getLevelData().getGameTime() % level.ticksPerSpawnCategory.getLong(org.bukkit.entity.SpawnCategory.ANIMAL) == 0L;
+        int l = level.getGameRules().getInt(GameRules.RULE_RANDOMTICKING);
+        // End
+
+        // Use moonrise's anyPlayerCloseEnoughForSpawning check
+        if (level.chunkSource.chunkMap.anyPlayerCloseEnoughForSpawning(chunkcoordintpair)) {
+            chunk1.incrementInhabitedTime(j);
+            // Pufferfish Code:
+            if (flag && (!gg.pufferfish.pufferfish.PufferfishConfig.enableAsyncMobSpawning || level.getChunkSource()._pufferfish_spawnCountsReady.get())
+                    && (level.chunkSource.spawnEnemies || level.chunkSource.spawnFriendlies)
+                    && level.getWorldBorder().isWithinBounds(chunkcoordintpair)) {
+                NaturalSpawner.spawnForChunk(level, chunk1, spawnState, level.chunkSource.spawnFriendlies, level.chunkSource.spawnEnemies, flag1);
+            }
+
+            level.tickChunk(chunk1, l);
+        }
+    }
+
+}
+
