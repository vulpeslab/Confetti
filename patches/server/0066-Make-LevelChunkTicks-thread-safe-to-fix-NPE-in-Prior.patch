+        } // Confetti - thread-safe
     }
 
     public void removeIf(Predicate<ScheduledTick<T>> predicate) {
+        synchronized (this.lock) { // Confetti - thread-safe
         Iterator<ScheduledTick<T>> iterator = this.tickQueue.iterator();
 
         while (iterator.hasNext()) {
