                 this.ticksPerPosition.remove(scheduledTick);
             }
         }
+        } // Confetti - thread-safe
     }
 
     public Stream<ScheduledTick<T>> getAll() {
+        synchronized (this.lock) { // Confetti - thread-safe
         return this.tickQueue.stream();
+        } // Confetti - thread-safe
     }
 
     @Override
     public int count() {
+        synchronized (this.lock) { // Confetti - thread-safe
         return this.tickQueue.size() + (this.pendingTicks != null ? this.pendingTicks.size() : 0);
+        } // Confetti - thread-safe
     }
 
     @Override
     public ListTag save(long l, Function<T, String> function) {
+        synchronized (this.lock) { // Confetti - thread-safe
         this.lastSaved = l; // Paper - rewrite chunk system
         ListTag listTag = new ListTag();
         if (this.pendingTicks != null) {
@@ -135,10 +158,12 @@ public class LevelChunkTicks<T> implements SerializableTickContainer<T>, TickCon
         }
 
         return listTag;
+        } // Confetti - thread-safe
     }
 
